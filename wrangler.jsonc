{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "werewolf",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": "."
  }
}
